PORT=3000
# Long random string. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
DATA_DIR=./data
# Show "N people have joined" only once the list reaches this size
PUBLIC_COUNT_MIN=50

# Welcome emails (https://resend.com). Verify privo.club in Resend first.
RESEND_API_KEY=
MAIL_FROM=Privo Club <support@privo.club>
MAIL_REPLY_TO=support@privo.club
# Base URL for links in emails
PUBLIC_URL=https://privo.club
