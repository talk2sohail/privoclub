package store

import (
	"context"
	"testing"
)

// R-04: a server that offers a different definition on every refresh adds one
// pending pin per refresh, for ever. After a load the pending pins that the
// server no longer offers are deleted. Accepted pins are decisions and stay.
func TestPrunePending(t *testing.T) {
	s, _ := open(t)
	ctx := context.Background()
	a, b := twoOrgs(t, s)
	pin := func(server, kind, name, hash string) Pin {
		return Pin{ServerID: server, Kind: kind, Name: name, Hash: hash, Definition: "{}"}
	}
	seen := []Pin{
		pin("srv", "tool", "echo", "h1"),    // accepted below
		pin("srv", "tool", "echo", "h2"),    // pending, still offered
		pin("srv", "tool", "echo", "h3"),    // pending, no longer offered
		pin("srv", "prompt", "echo", "h3"),  // same name and hash, other kind: no longer offered
		pin("srv", "resource", "r://x", "h"), // pending, still offered
		pin("srv", "tool", "gone", "h9"),    // accepted below, no longer offered
	}
	other := []Pin{pin("srv2", "tool", "echo", "h3")}
	for org, pins := range map[OrgID][]Pin{a: append(append([]Pin(nil), seen...), other...), b: seen} {
		if err := s.RecordSeen(ctx, org, pins); err != nil {
			t.Fatal(err)
		}
	}
	if got, _ := s.AcceptPins(ctx, a, "srv", []PinKey{{"tool", "echo", "h1"}, {"tool", "gone", "h9"}}); len(got) != 2 {
		t.Fatalf("accepted %v", got)
	}

	keep := []PinKey{{"tool", "echo", "h2"}, {"resource", "r://x", "h"}}
	n, err := s.PrunePending(ctx, a, "srv", keep)
	if err != nil {
		t.Fatal(err)
	}
	if n != 2 {
		t.Errorf("deleted %d pins, want 2 (the two pending h3 pins)", n)
	}
	st, _ := s.PinStatuses(ctx, a, "srv")
	want := map[PinKey]string{
		{"tool", "echo", "h1"}:     PinAccepted,
		{"tool", "echo", "h2"}:     PinPending,
		{"resource", "r://x", "h"}: PinPending,
		{"tool", "gone", "h9"}:     PinAccepted, // a decision, not offered any more, kept
	}
	if len(st) != len(want) {
		t.Errorf("statuses %v, want %v", st, want)
	}
	for k, v := range want {
		if st[k] != v {
			t.Errorf("pin %v is %q, want %q", k, st[k], v)
		}
	}

	if st2, _ := s.PinStatuses(ctx, a, "srv2"); len(st2) != 1 {
		t.Errorf("another server of the same org lost its pins: %v", st2)
	}
	if st3, _ := s.PinStatuses(ctx, b, "srv"); len(st3) != len(seen) {
		t.Errorf("another org lost its pins: %v", st3)
	}

	// A second run with the same list changes nothing, and an empty list
	// removes every pending pin of that server and nothing else.
	if n, _ := s.PrunePending(ctx, a, "srv", keep); n != 0 {
		t.Errorf("second run deleted %d pins", n)
	}
	if n, _ := s.PrunePending(ctx, a, "srv", nil); n != 2 {
		t.Errorf("empty keep list deleted %d pins, want the 2 pending ones", n)
	}
	if st, _ := s.PinStatuses(ctx, a, "srv"); len(st) != 2 || st[PinKey{"tool", "echo", "h1"}] != PinAccepted {
		t.Errorf("after pruning everything pending: %v", st)
	}
}
